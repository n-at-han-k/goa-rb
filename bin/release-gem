#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the Apache License, Version 2.0.
# Copyright, 2026, by General Intelligence Systems.

# RELEASE-GEM(1)                     General Commands Manual                   RELEASE-GEM(1)
#
# NAME
#      bin/release-gem — publish this version
#
# SYNOPSIS
#      bin/release-gem
#
# DESCRIPTION
#      There is one gem per version: goa-X.Y.Z.gem, platform-independent.  The binding is
#      GObjectIntrospection::Loader reading Goa-1.0.typelib at require time, so there is no
#      extension of this gem's own to compile and nothing to build per platform.  This
#      script therefore builds and pushes, and that is the whole release.
#
#      It used to download precompiled platform gems from a Cross Compile workflow.  That
#      went with the extension: there are no platform gems now, and no workflow to download
#      them from.
#
#      Before it builds anything it checks that the local version is ahead of what is on
#      RubyGems, which is the one mistake that cannot be taken back: a pushed version is
#      pushed.  A gem which is already up is skipped rather than failed, so a release which
#      died part way through can be run again.
#
#      It is not `gem kit release`, so it skips the gates that applies — a changelog entry
#      for this version, no due deprecation deadline, a clean working tree.  Run
#      `gem kit release --dry-run` first to get them.
#
# EXIT STATUS
#      The bin/release-gem utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/test(1), gem(1)
#
# goa                              November 3, 2026                      RELEASE-GEM(1)

require_relative "../lib/goa/version"
require "open3"

local_version = Goa::VERSION
gem_name = "goa"
gemspec = "goa.gemspec"

puts "Local version: #{local_version}"

# The local version has to be ahead of what is published, which is the one mistake that cannot be taken back: a pushed version is pushed.
remote_output = `gem specification #{gem_name} version --remote 2>&1`

if $?.success?
  remote_version = remote_output[/version: (.+)/, 1]&.strip
  puts "Remote version: #{remote_version}"

  if Gem::Version.new(local_version) <= Gem::Version.new(remote_version)
    abort "ERROR: Local version (#{local_version}) has not been incremented past remote (#{remote_version})"
  end
else
  puts "Gem not yet published remotely, proceeding with first release"
end

puts "\nBuilding #{gem_name} #{local_version} from #{gemspec}..."

system("gem build #{gemspec}") || abort("ERROR: gem build failed")

gem_file = "#{gem_name}-#{local_version}.gem"

# The gem is built from the gemspec, so an extension could only appear by someone adding one. Checking the built artefact is cheap and says what shipped rather than what was meant to ship.
spec = Gem::Specification.load(gemspec)

unless spec.extensions.empty?
  abort "ERROR: #{gemspec} declares extensions (#{spec.extensions.join(', ')}). This gem is pure Ruby; see README.md."
end

puts "\nPushing #{gem_file}..."

out, status = Open3.capture2e("gem", "push", gem_file)

print out

unless status.success?
  if out.include?("has already been pushed")
    puts "  (already published — skipping)"
  else
    abort "ERROR: gem push failed for #{gem_file}"
  end
end

puts "\nReleased #{gem_name} #{local_version}"

tag = "v#{local_version}"

system("git", "tag", "-a", tag, "-m", "Release #{local_version}")
system("git", "push", "origin", tag)
